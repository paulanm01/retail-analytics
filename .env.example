# Copy this file to .env and fill in your own values.

# Database credentials — used by docker-compose.yml
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=retail_analytics
DB_PORT=5433

# Connection string used by the Flask application.
# Must match the credentials above.
DATABASE_URL=postgresql://your_user:your_password@localhost:5433/retail_analytics

SECRET_KEY=any-random-string
FLASK_APP=run.py
FLASK_DEBUG=1